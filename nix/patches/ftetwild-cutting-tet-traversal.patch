+namespace {
+struct CuttingTetTraversalScratch {
+    std::vector<bool> visited;
+    std::vector<int>  touched_t_ids;
+    std::vector<int>  queue_t_ids;
+
+    void reset(std::size_t tet_count)
+    {
+        // Clear only the bits reached by the previous triangle. Keeping the
+        // packed array alive avoids allocating and zeroing mesh.tets.size()
+        // bits for every attempted input face.
+        for (int t_id : touched_t_ids)
+            visited[static_cast<std::size_t>(t_id)] = false;
+
+        touched_t_ids.clear();
+        queue_t_ids.clear();
+
+        // resize() initializes only newly added bits unless capacity growth is
+        // required. Existing storage and queue capacity are retained.
+        if (visited.size() < tet_count)
+            visited.resize(tet_count, false);
+    }
+
+    bool enqueue_once(int t_id)
+    {
+        const std::size_t index = static_cast<std::size_t>(t_id);
+        if (visited[index])
+            return false;
+
+        visited[index] = true;
+        touched_t_ids.push_back(t_id);
+        queue_t_ids.push_back(t_id);
+        return true;
+    }
+};
+
+struct TriangleInsertionWorkScratch {
+    std::vector<int>                             cut_t_ids;
+    std::vector<floatTetWild::Vector3>          points;
+    std::map<std::array<int, 2>, int>           map_edge_to_intersecting_point;
